rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Portades de llibres: lectura pública (per visualització) i escriptura autenticada (màx 10 MB, només imatges)
    match /covers/{libraryId}/{bookId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Fotografies de baldes: lectura pública i escriptura autenticada (màx 20 MB, només imatges)
    match /libraries/{libraryId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Denega qualsevol altre accés no autoritzat
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

